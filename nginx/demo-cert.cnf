[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = req_distinguished_name
x509_extensions = req_extensions

[req_distinguished_name]
CN = localhost

[req_extensions]
subjectAltName = @alt_names
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
DNS.1 = localhost
DNS.2 = cap.localhost
DNS.3 = full.localhost
DNS.4 = dummy.localhost
DNS.5 = hcaptcha.localhost
DNS.6 = altcha.localhost
DNS.7 = dashboard.localhost
IP.1 = 127.0.0.1
IP.2 = ::1