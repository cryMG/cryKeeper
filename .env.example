# Optional environment-based configuration for Gatekeeper.
#
# The checked-in docker-compose.yml prefers config.toml and uses only
# GATEKEEPER_CAP_ADMIN_KEY directly for the bundled local CAP container.
# The remaining GATEKEEPER_* entries below document optional environment-based
# configuration for deployments that prefer env vars over TOML or want to
# override the Docker image runtime defaults.
#
# For local end-to-end testing with the checked-in compose stack, use:
# docker compose up --build
# The local nginx entry point redirects http://localhost:8080 to the self-signed
# HTTPS endpoint on https://localhost:8443.
#
# In Docker Compose, non-empty GATEKEEPER_* values override matching shared
# defaults from config.toml. Optional [[website]] entries in config.toml are
# TOML-only and are not created or overridden via environment variables. The
# Gunicorn runtime variables below are separate and control only how the Docker
# image starts. Leave a value empty or remove the line if config.toml should
# control that option instead.

# -----------------------------------------------------------------------------
# Docker image runtime settings
# -----------------------------------------------------------------------------

# GATEKEEPER_GUNICORN_WORKERS
# Number of Gunicorn worker processes started by the bundled Docker image.
# The image defaults to 2 workers. Increase this only if the container has the
# CPU and memory budget for it.
GATEKEEPER_GUNICORN_WORKERS=2

# GATEKEEPER_GUNICORN_THREADS
# Number of threads per Gunicorn worker in the bundled Docker image.
# The image defaults to 4 threads per worker.
GATEKEEPER_GUNICORN_THREADS=4

# -----------------------------------------------------------------------------
# Demo-only helper settings
# -----------------------------------------------------------------------------

# GATEKEEPER_CAP_ADMIN_KEY
# Admin key for the bundled local Cap container used by docker-compose.yml.
# This does not affect the gatekeeper application itself.
GATEKEEPER_CAP_ADMIN_KEY=change-this-admin-key-with-at-least-32-characters

# -----------------------------------------------------------------------------
# Gatekeeper application settings
# -----------------------------------------------------------------------------

# GATEKEEPER_CONFIG_FILE
# Optional TOML config file with shared [gatekeeper] defaults and optional
# [[website]] overrides.
# If the file exists, its shared defaults are loaded before individual
# GATEKEEPER_* env vars. Matching [[website]] entries are then applied per host.
# Keys use the env var names without the GATEKEEPER_ prefix and in lowercase.
# The container image defaults this to /app/config.toml.
GATEKEEPER_CONFIG_FILE=/app/config.toml

# GATEKEEPER_SECRET_KEY
# HMAC signing key for the human-verification cookie.
# Replace this with a long random value in every non-development environment.
# Gatekeeper refuses to start while this placeholder value is still configured.
GATEKEEPER_SECRET_KEY=change-me-in-production

# GATEKEEPER_HUMAN_COOKIE_NAME
# Name of the signed cookie that marks a client as verified.
# If this stays on the default name and secure cookies are enabled, the app will
# automatically upgrade it to __Host-gatekeeper_verified.
GATEKEEPER_HUMAN_COOKIE_NAME=gatekeeper_verified

# GATEKEEPER_HUMAN_COOKIE_TTL_SECONDS
# How long a successful verification stays valid, in seconds.
# 604800 seconds = 7 days.
GATEKEEPER_HUMAN_COOKIE_TTL_SECONDS=604800

# GATEKEEPER_HUMAN_COOKIE_SECURE
# Set this to true when the gatekeeper is served over HTTPS.
# Keep it false only for local plain-HTTP development.
GATEKEEPER_HUMAN_COOKIE_SECURE=false

# GATEKEEPER_ALLOW_INSECURE_LOCAL_CAP
# Keep this false by default. Set it to true only when you deliberately want to
# test CAP mode over plain HTTP on localhost during development.
# Non-local HTTP challenge and verify requests remain blocked even with this override.
GATEKEEPER_ALLOW_INSECURE_LOCAL_CAP=false

# GATEKEEPER_TRUSTED_PROXY_HOPS
# Number of reverse proxies whose X-Forwarded-For and X-Forwarded-Proto headers
# should be trusted. The default example assumes a single nginx hop in front of
# Gatekeeper. Increase this only if your real proxy chain is longer.
GATEKEEPER_TRUSTED_PROXY_HOPS=1

# GATEKEEPER_TRUSTED_PROXY_CIDRS
# Optional comma-separated list of proxy CIDRs that are allowed to supply
# forwarded headers. This complements GATEKEEPER_TRUSTED_PROXY_HOPS instead of
# replacing it: the CIDRs say who may send forwarded headers, the hop count says
# how many forwarded values should be consumed. When GATEKEEPER_TRUSTED_PROXY_HOPS
# is greater than 0, this value must not be empty or Gatekeeper aborts startup.
# Default example for Docker bridge/private container networks.
GATEKEEPER_TRUSTED_PROXY_CIDRS=172.16.0.0/12

# GATEKEEPER_HUMAN_COOKIE_BINDING
# Controls whether the signed cookie is also bound to client properties.
# "user-agent" is the default and blocks simple cookie replay from tools that do not
# also replay the same User-Agent header.
# "ip-user-agent" is stricter and also binds to the client IP seen by the gatekeeper,
# but may require a fresh verification after network changes. In nginx auth_request
# setups, make sure the /check subrequest forwards X-Forwarded-For in this mode.
# Set to "none" to disable client binding entirely.
GATEKEEPER_HUMAN_COOKIE_BINDING=user-agent

# GATEKEEPER_LOG_LEVEL
# Application log verbosity. Typical values: DEBUG, INFO, WARNING, ERROR.
GATEKEEPER_LOG_LEVEL=INFO

# GATEKEEPER_VERIFICATION_MODE
# Use "dummy" for local wiring tests without a real provider.
# Use "cap" to require a self-hosted Cap verification.
# Use "hcaptcha" to require hCaptcha verification with site and secret keys.
# Use "altcha" to use the ALTCHA widget plus server-side cryptographic verification.
GATEKEEPER_VERIFICATION_MODE=dummy

# GATEKEEPER_PATH_PREFIX
# Public URL namespace reserved for the gatekeeper endpoints.
# Must start with "/" and must not end with "/". Default: /gatekeeper
# This env var controls the shared default prefix only. Per-website path_prefix
# overrides are possible only in config.toml via [[website]].
# The bundled demo stack pins its default host to /gatekeeper and does not wire
# this variable through to the demo nginx container.
GATEKEEPER_PATH_PREFIX=/gatekeeper

# GATEKEEPER_MAX_RETURN_PATH_LENGTH
# Maximum accepted length of the original return path.
# Requests with longer return values are normalized back to "/".
GATEKEEPER_MAX_RETURN_PATH_LENGTH=2048

# GATEKEEPER_FOOTER_HTML
# Optional trusted HTML rendered at the bottom of the challenge page.
# This env var is one shared string for all languages. Per-website overrides and
# locale-specific footer_html tables are TOML-only. The content is rendered
# as-is and is not sanitized.
GATEKEEPER_FOOTER_HTML=

# GATEKEEPER_SKIP_ROUTES
# Optional auth bypass rules in oauth2-proxy-like syntax.
# Use REGEX to skip all methods for a path, or METHOD=REGEX for method-specific
# bypasses. The regex matches the original request path without the query
# string, for example: ^/healthz$,GET=^/assets/,POST=^/api/
# In config.toml, use skip_routes as an array of strings instead.
GATEKEEPER_SKIP_ROUTES=

# GATEKEEPER_CHALLENGE_RATE_LIMIT_REQUESTS
# GATEKEEPER_CHALLENGE_RATE_LIMIT_WINDOW_SECONDS
# GATEKEEPER_CHALLENGE_RATE_LIMIT_BLOCK_SECONDS
# Best-effort in-process rate limit for GET /challenge. Set REQUESTS to 0 to disable.
GATEKEEPER_CHALLENGE_RATE_LIMIT_REQUESTS=20
GATEKEEPER_CHALLENGE_RATE_LIMIT_WINDOW_SECONDS=60
GATEKEEPER_CHALLENGE_RATE_LIMIT_BLOCK_SECONDS=120

# GATEKEEPER_VERIFY_RATE_LIMIT_REQUESTS
# GATEKEEPER_VERIFY_RATE_LIMIT_WINDOW_SECONDS
# GATEKEEPER_VERIFY_RATE_LIMIT_BLOCK_SECONDS
# Best-effort in-process rate limit for POST /verify. Set REQUESTS to 0 to disable.
GATEKEEPER_VERIFY_RATE_LIMIT_REQUESTS=10
GATEKEEPER_VERIFY_RATE_LIMIT_WINDOW_SECONDS=60
GATEKEEPER_VERIFY_RATE_LIMIT_BLOCK_SECONDS=300

# GATEKEEPER_RATE_LIMIT_MAX_ENTRIES
# Soft upper bound for in-memory rate-limit buckets kept by each worker process.
GATEKEEPER_RATE_LIMIT_MAX_ENTRIES=10000

# GATEKEEPER_RATE_LIMIT_BACKEND
# Rate-limit storage backend: auto, memory, or valkey.
# "auto" uses Valkey when GATEKEEPER_RATE_LIMIT_VALKEY_URL is set, otherwise it
# falls back to per-worker in-memory limits. If you keep the Docker image
# default of multiple Gunicorn workers, Valkey is recommended for consistent
# effective rate limits across the whole container.
GATEKEEPER_RATE_LIMIT_BACKEND=auto

# GATEKEEPER_RATE_LIMIT_VALKEY_URL
# Optional Valkey/Redis URL for distributed rate limits.
# Example for the local demo stack: redis://valkey:6379/1
# This stays a shared global setting. Individual [[website]] entries in
# config.toml must not override it.
GATEKEEPER_RATE_LIMIT_VALKEY_URL=

# GATEKEEPER_RATE_LIMIT_VALKEY_PREFIX
# Key prefix used for the distributed rate-limit buckets.
GATEKEEPER_RATE_LIMIT_VALKEY_PREFIX=gatekeeper:rl

# -----------------------------------------------------------------------------
# Cap integration settings
# -----------------------------------------------------------------------------

# GATEKEEPER_CAP_PUBLIC_BASE_URL
# Browser-facing Cap base URL used for widget assets and browser-side requests.
# Example with an external deployment: https://cap.example.com
# Example with the optional local HTTPS demo stack: https://localhost:8443/cap
GATEKEEPER_CAP_PUBLIC_BASE_URL=https://cap.example.com

# GATEKEEPER_CAP_INTERNAL_BASE_URL
# Optional server-side Cap base URL used for POST /siteverify.
# If you leave this unset, the gatekeeper automatically falls back to
# GATEKEEPER_CAP_PUBLIC_BASE_URL.
# In the optional local demo stack this is usually http://cap:3000.
GATEKEEPER_CAP_INTERNAL_BASE_URL=

# GATEKEEPER_CAP_ASSET_BASE_URL
# Optional override for where widget.js and cap_wasm.js are loaded from.
# In most setups this should match GATEKEEPER_CAP_PUBLIC_BASE_URL.
# Leave this equal to GATEKEEPER_CAP_PUBLIC_BASE_URL unless you deliberately serve assets
# from a different host or path.
GATEKEEPER_CAP_ASSET_BASE_URL=https://cap.example.com

# GATEKEEPER_CAP_SITE_KEY
# Public site key created in the Cap dashboard for this protected site.
GATEKEEPER_CAP_SITE_KEY=

# GATEKEEPER_CAP_SECRET_KEY
# Secret key paired with GATEKEEPER_CAP_SITE_KEY.
# The gatekeeper sends this to Cap's /siteverify endpoint.
GATEKEEPER_CAP_SECRET_KEY=

# GATEKEEPER_CAP_VERIFY_TIMEOUT_SECONDS
# Timeout for the gatekeeper's server-side verification request to Cap.
# Increase this only if your Cap deployment is consistently slower to respond.
GATEKEEPER_CAP_VERIFY_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# hCaptcha integration settings
# -----------------------------------------------------------------------------

# GATEKEEPER_HCAPTCHA_SCRIPT_URL
# Browser-facing hCaptcha API script URL. The default explicit-render setup is
# https://js.hcaptcha.com/1/api.js?render=explicit
GATEKEEPER_HCAPTCHA_SCRIPT_URL=https://js.hcaptcha.com/1/api.js?render=explicit

# GATEKEEPER_HCAPTCHA_SITE_KEY
# Public hCaptcha site key. For demos and CI, hCaptcha provides public test keys.
GATEKEEPER_HCAPTCHA_SITE_KEY=

# GATEKEEPER_HCAPTCHA_SECRET_KEY
# Secret key paired with GATEKEEPER_HCAPTCHA_SITE_KEY.
GATEKEEPER_HCAPTCHA_SECRET_KEY=

# GATEKEEPER_HCAPTCHA_VERIFY_URL
# Server-side hCaptcha siteverify endpoint.
GATEKEEPER_HCAPTCHA_VERIFY_URL=https://api.hcaptcha.com/siteverify

# GATEKEEPER_HCAPTCHA_VERIFY_TIMEOUT_SECONDS
# Timeout for the gatekeeper's server-side verification request to hCaptcha.
GATEKEEPER_HCAPTCHA_VERIFY_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# ALTCHA integration settings
# -----------------------------------------------------------------------------

# GATEKEEPER_ALTCHA_SCRIPT_URL
# Optional ALTCHA v3 widget script URL override.
# Leave empty to use the gatekeeper-hosted bundled widget below the active path prefix.
GATEKEEPER_ALTCHA_SCRIPT_URL=

# GATEKEEPER_ALTCHA_HMAC_SECRET
# HMAC secret used to sign and verify generated ALTCHA challenges.
GATEKEEPER_ALTCHA_HMAC_SECRET=

# GATEKEEPER_ALTCHA_HMAC_KEY_SECRET
# Optional separate signing secret used for ALTCHA's fast verification path.
# Leave empty to fall back to GATEKEEPER_ALTCHA_HMAC_SECRET.
GATEKEEPER_ALTCHA_HMAC_KEY_SECRET=

# GATEKEEPER_ALTCHA_ALGORITHM
# ALTCHA proof-of-work algorithm. PBKDF2/SHA-256 is a sensible default.
GATEKEEPER_ALTCHA_ALGORITHM=PBKDF2/SHA-256

# GATEKEEPER_ALTCHA_CHALLENGE_COST
# Work factor for generated ALTCHA challenges.
GATEKEEPER_ALTCHA_CHALLENGE_COST=5000

# GATEKEEPER_ALTCHA_EXPIRES_SECONDS
# Lifetime of one generated ALTCHA challenge before it expires.
GATEKEEPER_ALTCHA_EXPIRES_SECONDS=300
